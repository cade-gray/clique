node_modules/
dist/
data/.trash/
# npm run dev works on this copy of data/, so local testing stays out of git.
data.local/
# Per-deployment history, not example data: rebuilt by backfill on first run elsewhere.
data/events.ndjson
iisnode/
*.tmp
# keep the empty logs folder so IIS (HttpPlatformHandler) has somewhere to write node.log
logs/*
!logs/.gitkeep

# Droplet deploy: runtime config lives on the droplet, never in git
.env
.env.*
!.env.example
