# Runtime configuration for the droplet container. Copy to /srv/clique/.env on the droplet
# (chmod 600, owned by the deploy user) and keep it out of git.
#
# Clique has no secrets of its own: there is no database and no login. Everything below is
# plain configuration, and the defaults are already baked into the image.

NODE_ENV=production

# Port inside the container. Must match the container side of the port mapping in
# compose.prod.yaml and the health check URL in .github/workflows/deploy.yml.
PORT=3000

# Where the board lives inside the container. The compose file mounts /srv/clique/data here,
# so leave this alone unless you change the mount too.
DATA_DIR=/data

# Set only if Clique is served from a sub-path (for example /clique) instead of the site root.
BASE_PATH=

# Image tag the droplet runs. The deploy publishes both :latest and the commit SHA; set this
# to a SHA and run `docker compose -f compose.prod.yaml up -d` to roll back.
TAG=latest
